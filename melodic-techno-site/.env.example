# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Flask secret key — change this to a long random string
SECRET_KEY=change-this-to-a-long-random-string

# Admin page password (plain text — it is hashed on first run)
ADMIN_PASSWORD=change-this-password

# Gmail SMTP settings for sending newsletters
# 1. Enable 2-Factor Auth on your Gmail account
# 2. Go to Google Account > Security > App Passwords
# 3. Generate an App Password for "Mail" and paste it below
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_FROM_NAME=TheFAB

# Site display name shown in the browser tab and nav
SITE_NAME=TheFAB
